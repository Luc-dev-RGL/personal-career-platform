# ————————————————————————————————————————————————————————
# Personal Career Platform — Variables d'environnement
# Copier ce fichier vers .env (jamais commité) et remplir les valeurs.
#   cp .env.example .env
# ————————————————————————————————————————————————————————

# Base de données PostgreSQL managée (Neon)
# Neon → Dashboard → Connection String (avec ?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/pcp?sslmode=require"

# Secret de hachage des tokens de session (auth maison).
# Générer avec : openssl rand -base64 48
AUTH_SECRET="remplacez-moi-par-une-chaine-aleatoire-longue"

# Redis (Upstash ou équivalent) — rate limiting + cache.
# Si vide : fallback automatique sur un cache mémoire en développement
# (le rate limiting reste fonctionnel mais par instance uniquement).
REDIS_URL="rediss://default:password@host:6379"

# Google Gemini (clé serveur UNIQUEMENT — jamais exposée au client)
# https://aistudio.google.com/apikey
GEMINI_API_KEY="votre-cle-gemini"
GEMINI_CHAT_MODEL="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# URL publique du site (utilisee pour les liens de suivi visiteur)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stockage des médias — local en dev.
# En production sur Vercel (filesystem read-only), renseigner
# BLOB_READ_WRITE_TOKEN (Vercel Blob) pour activer le stockage objet.
# Laisser vide en local : stockage disque ./public/uploads
BLOB_READ_WRITE_TOKEN=""

# Script de création du compte admin (npm run admin:create)
# Si vide, un mot de passe fort est généré et affiché une seule fois.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
