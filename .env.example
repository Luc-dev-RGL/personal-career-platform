# Base de donnÃ©es PostgreSQL managÃ©e (Neon)
# Neon â†’ Dashboard â†’ Connection String (avec ?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/pcp?sslmode=require"

# Secret de hachage des tokens de session (auth maison).
# GÃ©nÃ©rer avec : openssl rand -base64 48
AUTH_SECRET="remplacez-moi-par-une-chaine-aleatoire-longue"

# Redis (Upstash ou Ã©quivalent) â€” rate limiting + cache.
# Si vide : fallback automatique sur un cache mÃ©moire en dÃ©veloppement
# (le rate limiting reste fonctionnel mais par instance uniquement).
REDIS_URL="rediss://default:password@host:6379"

# Google Gemini (clÃ© serveur UNIQUEMENT â€” jamais exposÃ©e au client)
# https://aistudio.google.com/apikey
GEMINI_API_KEY="votre-cle-gemini"
GEMINI_CHAT_MODEL="gemini-3.6-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# URL publique du site (utilisee pour les liens de suivi visiteur)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stockage des mÃ©dias â€” local en dev.
# En production sur Vercel (filesystem read-only), renseigner
# BLOB_READ_WRITE_TOKEN (Vercel Blob) pour activer le stockage objet.
# Laisser vide en local : stockage disque ./public/uploads
BLOB_READ_WRITE_TOKEN=""

# Script de crÃ©ation du compte admin (npm run admin:create)
# Si vide, un mot de passe fort est gÃ©nÃ©rÃ© et affichÃ© une seule fois.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
